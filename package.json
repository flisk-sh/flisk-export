{
  "name": "@flisk-sh/flisk-export",
  "version": "0.5.0",
  "description": "Write a Render Blueprint (render.yaml), a Cloudflare wrangler.toml or a standalone docker-compose.yml from Flisk service.json files. Never deploys.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flisk-export": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flisk-sh/flisk-export.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc --project tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/flisk-sh/flisk-export#readme",
  "bugs": {
    "url": "https://github.com/flisk-sh/flisk-export/issues"
  }
}
